<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>SkiVideoViewer</string>
    <key>CFBundleIdentifier</key>
    <string>dk.dyregod.video-viewer</string>
    <key>CFBundleIconFile</key>
    <string>AlbisViewerIcon.png</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Ski Video Viewer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>7</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!--
    The redirect scheme a club-supplied Google client comes back through.
    It is this bundle's own identifier, which is not a coincidence: a Google
    iOS OAuth client accepts <registered-bundle-id>:/oauth2redirect, so a club
    registers its client against this string and the app ships one unchanging
    scheme instead of one it could not know until the club pasted its id.

    Only club-supplied clients use it. The built-in Mac client is a Desktop
    client and keeps its loopback listener (AppKitOAuthPresenter), because
    Google blocks loopback for iOS clients but still allows it for Desktop
    ones. ClubOAuthClientTests pins this scheme against ClubOAuthClientStore.
    -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dk.dyregod.video-viewer.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dk.dyregod.video-viewer</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
